{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "INNOVIK-part2/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "INNOVIK-part2/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/INNOVIK-part2/build/$1"
    }
  ]
}
